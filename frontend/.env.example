# Production Backend API URL (for Vercel deployment)
# In local development, leave this empty to use the local Vite proxy (/api -> http://localhost:5000/api)
# When deploying frontend to Vercel, set this to your deployed backend URL:
# VITE_API_BASE_URL=https://your-tolet-backend.onrender.com/api
VITE_API_BASE_URL=
