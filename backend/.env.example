# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"
# Cloud Production (PostgreSQL e.g. Neon.tech, Supabase, Render Postgres):
# DATABASE_URL="postgresql://username:password@ep-host.neon.tech/neondb?sslmode=require"

# CORS Allowed Origin (Single origin or comma-separated list)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Uploads Configuration (Local fallback)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Cloudinary Configuration (Optional - for persistent cloud image hosting on Render/Railway/Vercel)
# Sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_POST_MAX=15
RATE_LIMIT_REPORT_MAX=10
